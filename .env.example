# Configuração do Firebase (copie para .env.local e preencha os valores do projeto)
VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=neurobot-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=neurobot-dev
VITE_FIREBASE_STORAGE_BUCKET=neurobot-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Emuladores locais (true para usar Auth e Firestore locais em desenvolvimento)
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIRESTORE_EMULATOR_HOST=localhost:8080

